<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  {# ============================================================
     Adding new headline fonts for the poetry section
     ============================================================ #}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Display&display=swap" rel="stylesheet">

  {# Page title comes from front matter. #}
  <title>{{ title }}</title>

  <link rel="stylesheet" href="/assets/site.css">
</head>

<body>

  {# ============================================================
     TOP DATELINE BAR
     Shows byline count + last updated date
     ============================================================ #}
  <div class="topbar">
    <div class="wrap topbar-inner">
      <div class="dateline-left">
        Messenger Bylines • Since Friday, June 12, 2015:
        {{ messenger.length - 1 }}
      </div>

      <div class="dateline-right">
        Last updated {{ page.inputPath | lastUpdatedGit | date("EEE, MMM dd, yyyy") }}
      </div>
    </div>
  </div>


  {# ============================================================
     MAIN LAYOUT GRID
     Two-column: Sidebar (nav) + Main content
     Controlled via .layout CSS grid
     ============================================================ #}
  <div class="wrap layout">

    {# ============================================================
       SIDEBAR NAVIGATION
       - Navigation items defined as an array
       - aria-current automatically applied to active page
       - Uses relative URLs (better for static hosting)
       ============================================================ #}
   <aside class="sidebar">
  <div class="sidebar-title">Navigate</div>

  <nav aria-label="Site">
    <ul class="nav-list">

      {# Define site navigation in one place #}
      {% set nav = [
        { label: "Home", url: "/" },
        { label: "Poems", url: "/poems/" },
        { label: "Publications", url: "/publications/" },
        { label: "Refereeing", url: "/refereeing/" },
        { 
          label: "MCHS Almanac",
          url: "https://mchsalmanac.davemitchner.com/",
          target: "_blank",
          rel: "noopener"
        }
      ] %}

      {# Normalize current page URL (remove leading/trailing slashes) #}
      {% set here = page.url | trim("/") %}

      {# Loop through nav items #}
      {% for item in nav %}

        {# Normalize nav URL the same way #}
        {% set there = item.url | trim("/") %}

        <li>
          <a href="{{ item.url }}"
             {% if here == there %}
               aria-current="page"
             {% endif %}
             {% if item.target %}
               target="{{ item.target }}"
             {% endif %}
             {% if item.rel %}
               rel="{{ item.rel }}"
             {% endif %}>
            {{ item.label }}
          </a>
        </li>

      {% endfor %}
    </ul>
  </nav>
</aside>

    {# ============================================================
       MAIN CONTENT AREA
       Eleventy injects page content here
       ============================================================ #}
    <main class="content">
      {{ content | safe }}
    </main>

  </div>

</body>
</html>