---
layout: base.njk
title: "Poems"
permalink: "/poems/"
---
<p class="poem-title">Poems I've Written</p>

<ul class="links">
  {% set poems = collections.poems | sort(attribute="data.title") %}

  {% for poem in poems %}
    <li>
      <a href="{{ poem.url }}">{{ poem.data.title }}</a>
    </li>
  {% endfor %}
</ul>